<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>GitHub Auto Installer</Product>
    <Description>Repository-Aware Windows installer and deployment utility for GitHub repositories.</Description>
    <Version>1.2.0</Version>
    <Authors>NAS</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GitHubAutoInstaller.SmokeTests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <Target Name="RestoreSmokeTests" AfterTargets="Restore">
    <MSBuild Projects="GitHubAutoInstaller.SmokeTests\GitHubAutoInstaller.SmokeTests.csproj" Targets="Restore" />
  </Target>

  <Target Name="BuildSmokeTests" AfterTargets="Build" Condition="'$(BuildingSmokeTests)' != 'true'">
    <MSBuild Projects="GitHubAutoInstaller.SmokeTests\GitHubAutoInstaller.SmokeTests.csproj" Targets="Build" Properties="Configuration=$(Configuration);BuildingSmokeTests=true" />
  </Target>

</Project>
