<Window x:Class="GitHubAutoInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Auto Installer"
        Width="920"
        Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F6">

    <Window.Resources>
        <Style x:Key="MacCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D8DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="28"
                Background="#F9FAFC"
                BorderBrush="#D9DFEA"
                BorderThickness="1"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="104"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#FF5F57" Margin="0,0,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#28C840"/>
                    </StackPanel>

                    <TextBlock Text="Installer"
                               Foreground="#111827"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,22,0,0"/>

                    <TextBlock Text="GitHub Releases"
                               Foreground="#6B7280"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <Border CornerRadius="18" Background="#111827" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mode" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Desktop Apps" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="18" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Target" Foreground="#6B7280" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Windows x64" Foreground="#111827" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="18" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Formats" Foreground="#6B7280" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=".exe  .msi  .zip" Foreground="#111827" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <CheckBox x:Name="SilentCheck" Content="Force Silent" IsChecked="False" Foreground="#111827" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShortcutCheck" Content="Desktop shortcut" IsChecked="True" Foreground="#111827" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="NotifyCheck" Content="Notification" IsChecked="True" Foreground="#111827" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="144"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource MacCard}"
                    Padding="18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="18"
                            Background="#F3F5F8"
                            BorderBrush="#DDE3EC"
                            BorderThickness="1">

                        <TextBox x:Name="UrlBox"
                                 Height="48"
                                 FontSize="15"
                                 Padding="16,0"
                                 Background="Transparent"
                                 Foreground="#111827"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Text="https://github.com/"/>
                    </Border>

                    <Button x:Name="PasteButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Style="{StaticResource MacButton}"
                            Background="#E8EDF5"
                            Click="PasteButton_Click">
                        <TextBlock Text="⧉" Foreground="#111827" FontSize="22"/>
                    </Button>

                    <Button x:Name="GoButton"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Style="{StaticResource MacButton}"
                            Background="#007AFF"
                            Click="GoButton_Click">
                        <TextBlock Text="Install" Foreground="White" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource MacCard}"
                    Margin="0,14,0,0"
                    Padding="18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="62"
                            Height="62"
                            CornerRadius="18"
                            Background="#F3F5F8"
                            BorderBrush="#DDE3EC"
                            BorderThickness="1"
                            VerticalAlignment="Top">

                        <Image x:Name="RepoAvatar" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="RepoTitle"
                                   Text="Repository Info"
                                   Foreground="#111827"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="RepoDescription"
                                   Text="Paste a GitHub repository URL, then press Install."
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxHeight="38"
                                   Margin="0,5,0,0"/>

                        <WrapPanel Margin="0,14,0,0" Height="32">
                            <Border CornerRadius="12" Background="#EEF2F7" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Version " Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock x:Name="RepoVersion" Text="-" Foreground="#111827" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="12" Background="#EEF2F7" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stars " Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock x:Name="RepoStars" Text="-" Foreground="#111827" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="12" Background="#EEF2F7" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Asset " Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock x:Name="RepoAsset"
                                               Text="-"
                                               Foreground="#111827"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               MaxWidth="230"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource MacCard}"
                    Margin="0,14,0,0"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="StepText"
                                   Text="Waiting..."
                                   Foreground="#111827"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="PercentText"
                                   Text="0%"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Row="1"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource MacCard}"
                    Margin="0,14,0,0"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Activity Log"
                               Foreground="#111827"
                               FontSize="15"
                               FontWeight="Bold"/>

                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             IsReadOnly="True"
                             Background="#F6F8FB"
                             Foreground="#1F2937"
                             FontFamily="Consolas"
                             FontSize="12"
                             BorderBrush="#E5E7EB"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>