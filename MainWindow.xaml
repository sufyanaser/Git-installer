<Window x:Class="GitHubAutoInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Auto Installer - Repository-Aware Windows Deployment"
        Width="1120"
        Height="840"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E14"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A96F8"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121821"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#171F2A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263140"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D9AAD"/>
        <SolidColorBrush x:Key="StatusReadyBrush" Color="#334155"/>
        <SolidColorBrush x:Key="StatusWorkingBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#B42335"/>
        <SolidColorBrush x:Key="StatusSuccessBrush" Color="#137A55"/>
        <SolidColorBrush x:Key="StatusWarningBrush" Color="#A16207"/>

        <Style x:Key="FocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3"
                                BorderBrush="#93B9FF"
                                BorderThickness="2"
                                CornerRadius="9"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <Style x:Key="TextActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="#B8C3D1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE4ED"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="#202936"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#171F2A"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0"
                Style="{StaticResource ConsoleCard}"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="NAS"
                               Foreground="#7DA7F7"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="GitHub Installer"
                               Margin="0,8,0,0"
                               FontSize="23"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Repository-aware deployment"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Border Background="#192334"
                            BorderBrush="#2A3B55"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INSPECTION ENGINE"
                                       Foreground="#7597CB"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Repository-Aware"
                                       Margin="0,7,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TARGET"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Windows x64"
                                           Margin="0,7,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="#243044"
                                    CornerRadius="8"
                                    Padding="8,5">
                                <TextBlock Text="EXE/MSI/ZIP/7z/CLI"
                                           Foreground="#A9BBD5"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="INSTALL OPTIONS"
                               Margin="2,16,0,12"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <CheckBox x:Name="SilentCheck"
                              Content="Request silent mode"
                              Margin="2,0,0,12"/>
                    <CheckBox x:Name="ShortcutCheck"
                              Content="Create desktop shortcut"
                              IsChecked="True"
                              Margin="2,0,0,12"/>
                    <CheckBox x:Name="NotifyCheck"
                              Content="Show completion prompt"
                              IsChecked="True"
                              Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="GitHub API · Public repositories"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock Text="Build 1.2.0 · win-x64"
                               Margin="0,5,0,0"
                               Foreground="#657286"
                               FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Repository-Aware Installer"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Inspect repository ecosystem, review installation plan, then confirm and deploy."
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"/>
                </StackPanel>
                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{StaticResource StatusReadyBrush}"
                        CornerRadius="12"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="7"
                                 Height="7"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="#CBD5E1"/>
                        <TextBlock x:Name="StatusText"
                                   Text="READY"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- URL Input Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource ConsoleCard}"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REPOSITORY URL"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="#0D131B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBox x:Name="UrlBox"
                                     Text="https://github.com/"
                                     Padding="14,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F1F5F9"
                                     CaretBrush="#93B9FF"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="UrlBox_TextChanged"
                                     AutomationProperties.Name="GitHub repository URL"/>
                        </Border>
                        <Button x:Name="PasteButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Content="Paste"
                                Style="{StaticResource SecondaryButton}"
                                Click="PasteButton_Click"
                                AutomationProperties.Name="Paste repository URL"/>
                        <Button x:Name="GoButton"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                Content="Inspect Repository"
                                Style="{StaticResource PrimaryButton}"
                                Click="GoButton_Click"
                                AutomationProperties.Name="Inspect and execute installation plan"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Repository & Plan Card -->
            <Border Grid.Row="2"
                    Style="{StaticResource ConsoleCard}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <!-- Metadata Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#1B2532"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Image x:Name="RepoAvatar"
                                   Stretch="UniformToFill"
                                   AutomationProperties.Name="Repository owner avatar"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RepoTitle"
                                           Text="Repository not inspected"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="CategoryBadge"
                                        Grid.Column="1"
                                        Background="#1E293B"
                                        CornerRadius="8"
                                        Padding="10,4"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CategoryText"
                                               Text="Directly Installable"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RepoDescription"
                                       Text="Enter a public repository URL to inspect its ecosystem and installation methods."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       MaxHeight="34"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Border Background="#1B2532" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Foreground="#BAC5D3" FontSize="11">
                                        <Run Text="Version "/><Run x:Name="RepoVersion" Text="—" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#1B2532" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Foreground="#BAC5D3" FontSize="11">
                                        <Run Text="Stars "/><Run x:Name="RepoStars" Text="—" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#1B2532" CornerRadius="8" Padding="10,5">
                                    <TextBlock Foreground="#BAC5D3" FontSize="11" MaxWidth="320" TextTrimming="CharacterEllipsis">
                                        <Run Text="Asset "/><Run x:Name="RepoAsset" Text="—" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Plan Details Section (Visible after inspection) -->
                    <StackPanel x:Name="PlanSection" Margin="0,14,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                        <!-- Method Selector Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="INSTALLATION METHOD:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,12,0"/>
                            <ComboBox x:Name="MethodComboBox"
                                      Grid.Column="1"
                                      SelectionChanged="MethodComboBox_SelectionChanged"
                                      AutomationProperties.Name="Available installation methods"/>
                        </Grid>

                        <!-- Plan Card Details -->
                        <Border Background="#0D131B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PlanTitle"
                                                   Text="Plan Title"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#F8FAFC"/>
                                        <TextBlock x:Name="PlanSummary"
                                                   Text="Summary of action"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="PermissionsBadge"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Background="#1E293B"
                                            CornerRadius="6"
                                            Padding="8,4">
                                        <TextBlock x:Name="PermissionsText"
                                                   Text="Standard User"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Proposed Command Box -->
                                <TextBlock Text="PROPOSED COMMANDS"
                                           Margin="0,10,0,4"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBox x:Name="ProposedCommandBox"
                                         Text="msiexec /i installer.msi"
                                         IsReadOnly="True"
                                         Background="#141C27"
                                         Foreground="#86EFAC"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="11"
                                         Padding="10,6"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         TextWrapping="Wrap"/>

                                <!-- Prerequisites & Verification -->
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,16,0">
                                        <Run Text="Tools: "/><Run x:Name="PlanToolsText" Text="None required" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,16,0">
                                        <Run Text="Verification: "/><Run x:Name="PlanVerificationText" Text="Local SHA-256 audit" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                        <Run Text="Destination: "/><Run x:Name="PlanDestinationText" Text="Managed by installer" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </WrapPanel>

                                <!-- Security Warning Banner -->
                                <Border x:Name="WarningBanner"
                                        Background="#2D1A04"
                                        BorderBrush="#B45309"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="WarningText"
                                               Foreground="#FDE68A"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Unsupported / Guarded Banner -->
                                <Border x:Name="UnsupportedBanner"
                                        Background="#301318"
                                        BorderBrush="#991B1B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="UnsupportedText"
                                               Foreground="#FECACA"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress Card -->
            <Border Grid.Row="3"
                    Style="{StaticResource ConsoleCard}"
                    Padding="18,14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="StepText"
                                   Text="Waiting for a repository URL."
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="PercentText"
                                   Text="0%"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 AutomationProperties.Name="Installation progress"/>
                </Grid>
            </Border>

            <!-- Activity Log Card -->
            <Border Grid.Row="4"
                    Style="{StaticResource ConsoleCard}"
                    Padding="18,14,18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="Activity log"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="Open downloads"
                                    Style="{StaticResource TextActionButton}"
                                    Margin="0,0,8,0"
                                    Click="OpenDownloadsButton_Click"/>
                            <Button Content="Copy"
                                    Style="{StaticResource TextActionButton}"
                                    Margin="0,0,8,0"
                                    Click="CopyLogButton_Click"/>
                            <Button Content="Clear"
                                    Style="{StaticResource TextActionButton}"
                                    Click="ClearLogButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Margin="0,6,0,0"
                             Padding="10"
                             IsReadOnly="True"
                             Background="#0D131B"
                             Foreground="#C8D2DE"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Installation activity log"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
